[Unit]
Description=mkubench V2 resumable driver (%i)
After=graphical-session.target

[Service]
Type=simple
WorkingDirectory=/var/home/fra/dev/mkubench
Environment=DISPLAY=:0
Environment=WAYLAND_DISPLAY=wayland-0
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /var/home/fra/dev/mkubench/scripts/hosten/run_driver.py %i --timeout 420 --deadline 00:05
StandardOutput=append:/var/home/fra/dev/mkubench/results/logs/mkubench-drv-%i.log
StandardError=append:/var/home/fra/dev/mkubench/results/logs/mkubench-drv-%i.log
Restart=no
TimeoutStopSec=30

[Install]
WantedBy=default.target
