[Unit]
Description=mkubench V2 hosten benchmark (8 available models)

[Service]
Type=simple
WorkingDirectory=/var/home/fra/dev/mkubench
EnvironmentFile=/var/home/fra/dev/mkubench/scripts/hosten/bench-v2.env
ExecStart=/bin/bash /var/home/fra/dev/mkubench/run_hosten_benchmark_v2.sh
StandardOutput=append:/var/home/fra/dev/mkubench/results/logs/mkubench_bench_v2.log
StandardError=append:/var/home/fra/dev/mkubench/results/logs/mkubench_bench_v2.log
Restart=no
